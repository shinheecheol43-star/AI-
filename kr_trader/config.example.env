# 이 파일을 복사해서 config.env 로 이름을 바꾸고 채우세요. config.env 는 남에게 보내거나 올리지 마세요.

# DRY = 주문 안 냄(가상 기록만) → MOCK = 키움 모의투자 → REAL = 실전
MODE=DRY

# 키움 REST API 앱키 (openapi.kiwoom.com 에서 발급, 모의투자용과 실전용이 따로임)
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=

# 실전(REAL)은 아래가 YES 일 때만 주문이 나감
REAL_CONFIRM=NO

# 이 프로그램이 굴릴 돈 (계좌 전체가 아니어도 됨. 이 돈 기준으로 비중을 계산)
START_CAPITAL=10000000

# 매매구분: 81 = 장마감 후 시간외 종가(15:40~16:00, 오늘 종가로 체결) · 3 = 시장가
ENTRY_ORDER_TYPE=81
EXIT_ORDER_TYPE=81
STOP_ORDER_TYPE=3

# 장중 손절 감시 간격(초)과 끝나는 시각
POLL_SECONDS=30
WATCH_END=15:20

# (선택) 텔레그램 알림
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
